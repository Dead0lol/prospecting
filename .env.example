# Fitness Coach Prospecting Pipeline
# Copy this file to `.env` and fill in the values you want to override.
# Blank values usually mean "feature disabled" or "use runtime fallback".

# -----------------------------------------------------------------------------
# Google Sheets export
# How to get:
# 1. Create a Google Cloud project.
# 2. Enable the Google Sheets API.
# 3. Create a service account and download its JSON key file.
# 4. Save that file in this repo (or elsewhere locally) and point
#    GOOGLE_SERVICE_ACCOUNT_FILE at it.
# 5. Share your target spreadsheet with the service account email.
# -----------------------------------------------------------------------------
GOOGLE_SHEET_NAME=Fitness Coach Leads
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json.json

# -----------------------------------------------------------------------------
# OpenRouter AI classification (optional)
# How to get:
# - Create an API key in OpenRouter: https://openrouter.ai/settings/keys
# - Leave ENABLE_AI=false to run the pipeline in heuristic-only mode.
# -----------------------------------------------------------------------------
ENABLE_AI=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# -----------------------------------------------------------------------------
# Discovery scope
# TARGET_COUNTRY is still used as a stored lead attribute and default run target.
# -----------------------------------------------------------------------------
TARGET_COUNTRY=US

# -----------------------------------------------------------------------------
# Timing and network behavior
# DISCOVERY_DELAY_SECONDS: sleep between DuckDuckGo queries
# WEBSITE_DELAY_SECONDS: sleep after each website fetch
# OPENROUTER_DELAY_SECONDS: pacing between OpenRouter calls when AI is enabled
# REQUEST_TIMEOUT_SECONDS: HTTP request timeout for website crawling
# DDGS_TIMEOUT_SECONDS: timeout passed to the DDGS client
# -----------------------------------------------------------------------------
DISCOVERY_DELAY_SECONDS=3
WEBSITE_DELAY_SECONDS=2
OPENROUTER_DELAY_SECONDS=4
REQUEST_TIMEOUT_SECONDS=20
DDGS_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# Search and crawl limits
# MAX_SEARCH_RESULTS_PER_QUERY: max DDG results requested per query
# MAX_DISCOVERY_QUERIES: number of discovery queries run per pipeline execution
# MAX_PAGES_PER_SITE: max path hints fetched per website during crawling
# -----------------------------------------------------------------------------
MAX_SEARCH_RESULTS_PER_QUERY=20
MAX_DISCOVERY_QUERIES=40
MAX_PAGES_PER_SITE=5

# -----------------------------------------------------------------------------
# Scoring thresholds
# Hot leads score at or above HOT_LEAD_THRESHOLD.
# Good leads score at or above GOOD_LEAD_THRESHOLD.
# -----------------------------------------------------------------------------
HOT_LEAD_THRESHOLD=65
GOOD_LEAD_THRESHOLD=45

# -----------------------------------------------------------------------------
# HTTP user agent
# You can usually leave this as-is.
# Change it only if you need a different browser fingerprint for crawling.
# -----------------------------------------------------------------------------
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# -----------------------------------------------------------------------------
# SMTP probe identity
# These values are used for SMTP HELO and MAIL FROM during mailbox verification.
# Best practice:
# - Use a hostname and mailbox you control.
# - If left blank in your local `.env`, the app falls back to a hostname-derived
#   value at runtime.
# Example:
# SMTP_PROBE_HELO_NAME=mail.yourdomain.com
# SMTP_PROBE_MAIL_FROM=postmaster@yourdomain.com
# -----------------------------------------------------------------------------
SMTP_PROBE_HELO_NAME=
SMTP_PROBE_MAIL_FROM=
